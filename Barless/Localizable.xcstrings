    },
    "Screenshot with the status bar hidden": {
      "comment": "画像の読み上げ",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバーを隠したスクショ"
          }
        }
      }
    },
    "Screenshots from this iPhone aren't supported yet": {
      "comment": "自動判定の対象にしていない機種のとき",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機種のスクショにはまだ対応していません"
          }
        }
      }
    },
    "Share": {
      "comment": "共有シートを開くボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有"
          }
        }
      }
    },
    "Show the original": {
      "comment": "読み上げの操作（元の画像を出す）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の画像を表示"
          }
        }
      }
    },
    "Show the result": {
      "comment": "読み上げの操作（元の画像から結果へ戻す）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果を表示"
          }
        }
      }
    },
    "Signal": {
      "comment": "「遊ぶ」の項目。電波の本数",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電波"
          }
        }
      }
    },
    "Status bar": {
      "comment": "画像のステータスバーの帯に付ける印",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバー"
          }
        }
      }
    },
    "Status bar height": {
      "comment": "手動調整のスライダーの読み上げ",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバーの高さ"
          }
        }
      }
    },
    "Tap the image to pick the fill color": {
      "comment": "手動調整で「色を拾う」を選んでいるときの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして塗る色を拾う"
          }
        }
      }
    },
    "Text color": {
      "comment": "手動調整の項目。ステータスバーの文字とアイコンの色",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字の色"
          }
        }
      }
    },
    "The background is a photo or pattern, so some traces may remain.": {
      "comment": "背景が複雑なときの注意",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が写真や模様のため跡が残ることがあります"
          }
        }
      }
    },
    "There's no room to draw Wi-Fi next to the carrier name": {
      "comment": "「遊ぶ」で、キャリア名が長くて Wi-Fi を描けない画像のときの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャリア名の右に、Wi-Fi を描く場所がありません"
          }
        }
      }
    },
    "Tidy": {
      "comment": "エディタのモード: 定番の表示に描き直す",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整える"
          }
        }
      }
    },
    "Time": {
      "comment": "「遊ぶ」の項目",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻"
          }
        }
      }
    },
    "Traces may remain with this background. Try Blur or Pick color.": {
      "comment": "手動調整で、背景が写真や模様のときの注意",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "跡が残りそうなときは「ぼかす」か「色を拾う」も試せます"
          }
        }
      }
    },
    "Try again.": {
      "comment": "保存に失敗したときの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度お試しください"
          }
        }
      }
    },
    "Try choosing it again.": {
      "comment": "画像を読み込めなかったときの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度選び直してください"
          }
        }
      }
    },
    "White": {
      "comment": "手動調整の選択肢（文字の色）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白"
          }
        }
      }
    },
    "Wi-Fi": {
      "comment": "「遊ぶ」の項目。Wi-Fi の本数",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi"
          }
        }
      }
    },
    "Your photos never leave this device.": {
      "comment": "ホームの下端の一言",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は端末の外に出ません"
          }
        }
      }
    },
    "iOS 18–26": {
      "comment": "iOS の世代",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 18〜26"
          }
        }
      }
    }
  },
  "version": "1.0"
