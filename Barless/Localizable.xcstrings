        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました"
          }
        }
      }
    },
    "Saving…": {
      "comment": "保存の途中",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しています…"
          }
        }
      }
    },
    "Screenshot with a customized status bar": {
      "comment": "「遊ぶ」の結果の画像の読み上げ",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバーの表示を変えたスクリーンショット"
          }
        }
      }
    },
    "Screenshot with a tidied status bar": {
      "comment": "画像の読み上げ（整える）",
