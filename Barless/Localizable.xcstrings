{
  "sourceLanguage": "en",
  "strings": {
    "Allow adding photos in Settings.": {
      "comment": "写真への追加が許可されていないときの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」で、写真への追加を許可してください。"
          }
        }
      }
    },
    "Analyzing…": {
      "comment": "画像を読み込んで解析している間の表示",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析しています…"
          }
        }
      }
    },
    "Back": {
      "comment": "書き出しから編集へ戻るボタン（読み上げ用）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻る"
          }
        }
      }
    },
    "Barless": {
      "comment": "アプリの名前（ホームの見出し）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キレスク"
          }
        }
      }
    },
    "Barless can't add to Photos": {
      "comment": "写真への追加が許可されていないときのお知らせ",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真に追加できません"
          }
        }
      }
    },
    "Cancel": {
      "comment": "お知らせを閉じるボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Choose a screenshot": {
      "comment": "ホームの主ボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクショを選ぶ"
          }
        }
      }
    },
    "Choose an iPhone screenshot that hasn't been cropped or resized.": {
      "comment": "大きさが合わないときの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り抜きや縮小をしていない、iPhone のスクリーンショットを選んでください。"
          }
        }
      }
    },
    "Choose an iPhone screenshot that shows the time, signal and battery at the top.": {
      "comment": "ステータスバーを見つけられないときの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上端に時刻・電波・電池が写っている iPhone のスクリーンショットを選んでください。"
          }
        }
      }
    },
    "Choose another screenshot": {
      "comment": "消せなかったときに、ホームへ戻るボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のスクショを選ぶ"
          }
        }
      }
    },
    "Close": {
      "comment": "編集を閉じるボタン（読み上げ用）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "Couldn't find the status bar": {
      "comment": "機種を決められない・文字やアイコンが見つからないとき",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバーを見つけられませんでした"
          }
        }
      }
    },
    "Couldn't open this image": {
      "comment": "画像を読み込めなかったとき",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像を開けませんでした"
          }
        }
      }
    },
    "Couldn't prepare the image for export": {
      "comment": "書き出すファイルを作れなかったとき",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しの準備に失敗しました"
          }
        }
      }
    },
    "Couldn't save the image": {
      "comment": "保存に失敗したときのお知らせ",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できませんでした"
          }
        }
      }
    },
    "Couldn't tell where the status bar is": {
      "comment": "画像の大きさが、対応している機種のどれとも合わないとき",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバーの位置が分かりませんでした"
          }
        }
      }
    },
    "Detected as %@ size · %@": {
      "comment": "判定の結果。1 つ目は機種名（iPhone 17）、2 つ目は iOS の世代（iOS 27）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 相当・%2$@ として認識"
          }
        }
      }
    },
    "Done": {
      "comment": "保存の後、ホームへ戻るボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        }
      }
    },
    "Format": {
      "comment": "書き出す画像の形式（PNG / HEIC）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形式"
          }
        }
      }
    },
    "Hide the time, battery and signal": {
      "comment": "ホームの主ボタンの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻・電池・電波を隠す"
          }
        }
      }
    },
    "Hold the image to see the original": {
      "comment": "編集の画面の操作の説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を押している間、元の画像を表示します"
          }
        }
      }
    },
    "Location and capture date are not included": {
      "comment": "書き出す画像のメタデータについての説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報と撮影日時は含めません"
          }
        }
      }
    },
    "OK": {
      "comment": "お知らせを閉じるボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Open Settings": {
      "comment": "設定アプリを開くボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        }
      }
    },
    "Original": {
      "comment": "元の画像を出している間、画像の隅に出す札",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の画像"
          }
        }
      }
    },
    "Original screenshot": {
      "comment": "画像の読み上げ（元の画像を出しているとき）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のスクリーンショット"
          }
        }
      }
    },
    "Save": {
      "comment": "編集から書き出しへ進むボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Save to Photos": {
      "comment": "書き出しの主ボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真に保存"
          }
        }
      }
    },
    "Saved": {
      "comment": "保存が済んだ後のボタンの表示",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました"
          }
        }
      }
    },
    "Saving…": {
      "comment": "保存の途中",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しています…"
          }
        }
      }
    },
    "Screenshot with the status bar hidden": {
      "comment": "画像の読み上げ",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバーを隠したスクリーンショット"
          }
        }
      }
    },
    "Screenshots from this iPhone aren't supported yet": {
      "comment": "自動判定の対象にしていない機種のとき",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機種のスクリーンショットには、まだ対応していません"
          }
        }
      }
    },
    "Share": {
      "comment": "共有シートを開くボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有"
          }
        }
      }
    },
    "Show the original": {
      "comment": "読み上げの操作（元の画像を出す）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の画像を表示"
          }
        }
      }
    },
    "Show the result": {
      "comment": "読み上げの操作（元の画像から結果へ戻す）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隠した結果を表示"
          }
        }
      }
    },
    "Status bar": {
      "comment": "画像のステータスバーの帯に付ける印",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバー"
          }
        }
      }
    },
    "The background is a photo or pattern, so some traces may remain": {
      "comment": "背景が複雑なときの注意",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が写真や模様のため、跡が残ることがあります"
          }
        }
      }
    },
    "Try again.": {
      "comment": "保存に失敗したときの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度お試しください。"
          }
        }
      }
    },
    "Try choosing it again.": {
      "comment": "画像を読み込めなかったときの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度選び直してください。"
          }
        }
      }
    },
    "Your photos never leave this device": {
      "comment": "ホームの下端の一言",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は端末の外に出ません"
          }
        }
      }
    },
    "iOS 18–26": {
      "comment": "iOS の世代",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 18〜26"
          }
        }
      }
    }
  },
  "version": "1.0"
}
