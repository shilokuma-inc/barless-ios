{
  "sourceLanguage": "en",
  "strings": {
    "9:41 · 4 bars · Full Wi-Fi · Battery 100%": {
      "comment": "「整える」で描き直す中身",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "9:41・電波 4 本・Wi-Fi 最大・電池 100%"
          }
        }
      }
    },
    "Adjust again": {
      "comment": "手動調整の結果から、調整の画面へ戻るボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調整し直す"
          }
        }
      }
    },
    "Adjust manually": {
      "comment": "自動で消せなかったときの、手動調整への入口",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動で調整する"
          }
        }
      }
    },
    "Adjusted manually": {
      "comment": "手動調整の結果であることの表示",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動で調整しました"
          }
        }
      }
    },
    "Allow adding photos in Settings.": {
      "comment": "写真への追加が許可されていないときの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」で写真への追加を許可してください"
          }
        }
      }
    },
    "Analyzing…": {
      "comment": "画像を読み込んで解析している間の表示",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析しています…"
          }
        }
      }
    },
    "Auto": {
      "comment": "手動調整の選択肢（文字の色・背景）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動"
          }
        }
      }
    },
    "Back": {
      "comment": "書き出しから編集へ戻るボタン（読み上げ用）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻る"
          }
        }
      }
    },
    "Background": {
      "comment": "手動調整の項目。帯の埋め方",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景"
          }
        }
      }
    },
    "Barless": {
      "comment": "アプリの名前（ホームの見出し）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キレスク"
          }
        }
      }
    },
    "Barless can't add to Photos": {
      "comment": "写真への追加が許可されていないときのお知らせ",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真に追加できません"
          }
        }
      }
    },
    "Battery": {
      "comment": "「遊ぶ」の項目。電池の残量",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電池"
          }
        }
      }
    },
    "Battery level": {
      "comment": "「遊ぶ」のスライダーの読み上げ",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電池の残量"
          }
        }
      }
    },
    "Black": {
      "comment": "手動調整の選択肢（文字の色）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黒"
          }
        }
      }
    },
    "Blur": {
      "comment": "手動調整の選択肢（背景）。帯の全体をぼかす",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぼかす"
          }
        }
      }
    },
    "Cancel": {
      "comment": "お知らせを閉じるボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Choose a screenshot": {
      "comment": "ホームの主ボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクショを選ぶ"
          }
        }
      }
    },
    "Choose an iPhone screenshot that hasn't been cropped or resized.": {
      "comment": "大きさが合わないときの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り抜きや縮小をしていない iPhone のスクショを選んでください"
          }
        }
      }
    },
    "Choose an iPhone screenshot that shows the time, signal and battery at the top.": {
      "comment": "ステータスバーを見つけられないときの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上端に時刻・電波・電池が写っている iPhone のスクショを選んでください"
          }
        }
      }
    },
    "Choose another screenshot": {
      "comment": "消せなかったときに、ホームへ戻るボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のスクショを選ぶ"
          }
        }
      }
    },
    "Close": {
      "comment": "編集を閉じるボタン（読み上げ用）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "Compare": {
      "comment": "元の画像と見比べる表示の入り切り（読み上げ用）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較"
          }
        }
      }
    },
    "Comparison with the original": {
      "comment": "画像の読み上げ（比較を出しているとき）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の画像との比較"
          }
        }
      }
    },
    "Continue with these settings": {
      "comment": "手動調整を終えて、結果を見る画面へ進むボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定で続ける"
          }
        }
      }
    },
    "Couldn't find the status bar": {
      "comment": "機種を決められない・文字やアイコンが見つからないとき",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバーを見つけられませんでした"
          }
        }
      }
    },
    "Couldn't identify the device": {
      "comment": "手動調整の画面の見出し",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機種を判定できませんでした"
          }
        }
      }
    },
    "Couldn't open this image": {
      "comment": "画像を読み込めなかったとき",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像を開けませんでした"
          }
        }
      }
    },
    "Couldn't prepare the image for export": {
      "comment": "書き出すファイルを作れなかったとき",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しの準備に失敗しました"
          }
        }
      }
    },
    "Couldn't save the image": {
      "comment": "保存に失敗したときのお知らせ",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できませんでした"
          }
        }
      }
    },
    "Couldn't tell where the status bar is": {
      "comment": "画像の大きさが、対応している機種のどれとも合わないとき",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスバーの位置が分かりませんでした"
          }
        }
      }
    },
    "Detected as %@-inch · %@": {
      "comment": "判定の結果。1 つ目は画面の大きさ（6.3）、2 つ目は iOS の世代（iOS 27）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ インチ・%2$@ として認識"
          }
        }
      }
    },
    "Done": {
      "comment": "保存の後、ホームへ戻るボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        }
      }
    },
    "Drag the handle to compare with the original": {
      "comment": "比較の操作の説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つまみを動かして元の画像と比較"
          }
        }
      }
    },
    "Format": {
      "comment": "書き出す画像の形式（PNG / HEIC）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形式"
          }
        }
      }
    },
    "Height": {
      "comment": "手動調整の項目。ステータスバーの帯の高さ",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高さ"
          }
        }
      }
    },
    "Hide": {
      "comment": "エディタのモード: ステータスバーを消す",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隠す"
          }
        }
      }
    },
    "Hide or tidy the time, battery and signal": {
      "comment": "ホームの主ボタンの説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻・電池・電波を隠して整える"
          }
        }
      }
    },
    "Hold the image to see the original": {
      "comment": "編集の画面の操作の説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しで元の画像を表示"
          }
        }
      }
    },
    "Keep": {
      "comment": "「遊ぶ」の時刻の選択肢。元の時刻を残す",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのまま"
          }
        }
      }
    },
    "Location and capture date are not included.": {
      "comment": "書き出す画像のメタデータについての説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報と撮影日時は含めません"
          }
        }
      }
    },
    "Move the green line to just below the status bar.": {
      "comment": "手動調整の画面の説明",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑の線をステータスバーのすぐ下に合わせてください"
          }
        }
      }
    },
    "OK": {
      "comment": "お知らせを閉じるボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Off": {
      "comment": "「遊ぶ」の Wi-Fi の選択肢。Wi-Fi の表示を消す",
