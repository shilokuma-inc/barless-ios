        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        }
      }
    },
    "Open Settings": {
      "comment": "設定アプリを開くボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        }
      }
    },
    "Original screenshot": {
      "comment": "画像の読み上げ（元の画像を出しているとき）",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のスクショ"
          }
        }
      }
    },
    "Pick color": {
      "comment": "手動調整の選択肢（背景）。画像から拾った 1 色で帯を塗る",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色を拾う"
          }
        }
      }
    },
    "Play": {
      "comment": "エディタのモード。時刻・電池・電波・Wi-Fi を好きな値に描き直す",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遊ぶ"
          }
        }
      }
    },
    "Save": {
      "comment": "編集から書き出しへ進むボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Save to Photos": {
      "comment": "書き出しの主ボタン",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真に保存"
